{
    "name": "local/recordatorio-tareas",
    "description": "Recordatorio de Tareas: app web local que crea tareas desde Gmail/Outlook y las escribe en el calendario.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-curl": "*",
        "league/oauth2-client": "^2.7",
        "league/oauth2-google": "^4.0",
        "thenetworg/oauth2-azure": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "sniff": "phpcs"
    },
    "config": {
        "optimize-autoloader": true
    }
}
