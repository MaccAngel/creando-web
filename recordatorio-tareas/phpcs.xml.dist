<?xml version="1.0"?>
<ruleset name="RecordatorioTareas">
    <description>
        Estándar PSR-12 para el código de lógica (lib/) y los tests.
        Las vistas de public/ mezclan HTML y PHP (efectos secundarios por
        diseño), así que no se incluyen aquí; de su formato se encarga
        PHP CS Fixer.
    </description>

    <!-- Rutas analizadas. -->
    <file>lib</file>
    <file>tests</file>

    <!-- Mostrar la regla incumplida y usar colores. -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Los avisos (p. ej. líneas largas) no hacen fallar el build, pero
         siguen mostrándose para tenerlos a la vista. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Estándar base. -->
    <rule ref="PSR12">
        <!-- Este proyecto sin framework carga sus librerías con require_once
             y define funciones en el mismo archivo (no hay autoloader para
             lib/). Es una decisión consciente, así que no aplicamos la regla
             de "sin efectos secundarios". -->
        <exclude name="PSR1.Files.SideEffects"/>
    </rule>

    <!-- Longitud de línea: avisa a 120, sin error absoluto. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
